---
// Hand-drawn inline SVG icons, one per skill. Stroke-based, inherits currentColor.
interface Props {
	icon: string;
}
const { icon } = Astro.props;

const open =
	'<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">';

const ICONS: Record<string, string> = {
	routing: `${open}<rect x="2.5" y="9.5" width="19" height="6" rx="1.5"/><path d="M6 12.5h.01M9 12.5h.01"/><path d="M15.5 11l2-1.8M15.5 14l2 1.8M18.5 12.5h2"/></svg>`,
	vpn: `${open}<path d="M3 12c3-4.5 6-4.5 9 0s6 4.5 9 0"/><circle cx="3.2" cy="12" r="1.6" fill="currentColor" stroke="none"/><circle cx="20.8" cy="12" r="1.6" fill="currentColor" stroke="none"/><path d="M9.5 6.5h5M9.5 17.5h5" stroke-dasharray="1.5 2.5"/></svg>`,
	security: `${open}<path d="M12 2.5 20 6v5.5c0 4.8-3.3 8.4-8 10-4.7-1.6-8-5.2-8-10V6l8-3.5Z"/><rect x="9" y="10" width="6" height="5" rx="0.8"/><path d="M10.5 10V8.5a1.5 1.5 0 0 1 3 0V10"/></svg>`,
	troubleshoot: `${open}<circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 5.5 5.5"/><path d="M7.5 10.5h2l1-2 1.5 3.5 1-1.5h1"/></svg>`,
	cloud: `${open}<path d="M7 17.5a4.5 4.5 0 0 1-.4-9A5.5 5.5 0 0 1 17.4 9.6 3.8 3.8 0 0 1 17 17.5H7Z"/><path d="M9 21h.01M12.5 21h.01M16 21h.01"/></svg>`,
	homelab: `${open}<rect x="4" y="3.5" width="16" height="5" rx="1"/><rect x="4" y="10" width="16" height="5" rx="1"/><rect x="4" y="16.5" width="16" height="4" rx="1"/><path d="M7 6h.01M7 12.5h.01M7 18.5h.01M15 6h2M15 12.5h2"/></svg>`,
	automation: `${open}<path d="m4 7 4 5-4 5"/><path d="M11 17h9"/><path d="M13.5 4.5 16 7l-2.5 2.5" opacity="0.55"/></svg>`,
	systems: `${open}<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.5M12 18.5V21M21 12h-2.5M5.5 12H3M18.4 5.6l-1.8 1.8M7.4 16.6l-1.8 1.8M18.4 18.4l-1.8-1.8M7.4 7.4 5.6 5.6"/></svg>`,
	fabric: `${open}<rect x="9.5" y="3" width="5" height="4.5" rx="0.8"/><rect x="3" y="16.5" width="5" height="4.5" rx="0.8"/><rect x="16" y="16.5" width="5" height="4.5" rx="0.8"/><path d="M12 7.5v4M12 11.5 5.5 16.5M12 11.5l6.5 5M12 11.5h.01"/></svg>`,
};
---

<Fragment set:html={ICONS[icon] ?? ICONS.systems} />
